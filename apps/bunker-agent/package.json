{
  "name": "@bunker/bunker-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Bunker Club NUC agent — read-only QRC mirror of the Q-SYS Core into Supabase audio_live (audio module PR A). Writes NOTHING to the Core.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "capture": "tsx src/capture-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test-isolation=none --test --test-timeout=15000 test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3"
  }
}
